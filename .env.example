ADMIN_TOKEN=change-me-to-something-long
DB_PATH=./data/router.db
MAX_ATTEMPTS=8
DEFAULT_COOLDOWN=20
SHORT_COOLDOWN=5
REQUEST_TIMEOUT=600
CONNECT_TIMEOUT=15
REQUIRE_GATEWAY_AUTH=true
ALLOW_UNAUTHENTICATED=false
CORS_ORIGINS=*
LOG_REQUESTS=true
MAX_LOG_ROWS=5000

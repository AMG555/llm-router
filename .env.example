# ---- required in production ----
ADMIN_TOKEN=change-me-to-a-long-random-value
SECRET_KEY=change-me-to-encrypt-stored-upstream-keys
ENV=production
PORT=7860

# ---- storage ----
DB_PATH=./data/router.db

# ---- upstream behaviour ----
MAX_ATTEMPTS=8
DEFAULT_COOLDOWN=20
SHORT_COOLDOWN=5
REQUEST_TIMEOUT=600
CONNECT_TIMEOUT=15

# ---- gateway surface ----
REQUIRE_GATEWAY_AUTH=true
GATEWAY_RPM=0
MAX_BODY_BYTES=2097152

# ---- web hardening ----
# empty CORS_ORIGINS => same-origin only
CORS_ORIGINS=
TRUSTED_HOSTS=*
ENABLE_DOCS=false
FORCE_HTTPS=false
ADMIN_MAX_FAILS=10
ADMIN_LOCK_SECONDS=300
# block upstreams that resolve to private/loopback ranges
BLOCK_PRIVATE_UPSTREAMS=false

# ---- misc ----
LOG_REQUESTS=true
MAX_LOG_ROWS=5000
# base64 of an exported config JSON, auto-imported on first boot
BOOTSTRAP_CONFIG=

# ---- optional: Cloudflare Tunnel (docker compose --profile tunnel) ----
# TUNNEL_TOKEN=

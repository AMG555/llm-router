# ---- required in production ----
ADMIN_TOKEN=change-me-to-a-long-random-value
SECRET_KEY=change-me-to-encrypt-stored-upstream-keys
ENV=production
PORT=7860

# ---- storage ----
DB_PATH=./data/router.db

# ---- upstream behaviour ----
MAX_ATTEMPTS=8
DEFAULT_COOLDOWN=20
SHORT_COOLDOWN=5
REQUEST_TIMEOUT=600
CONNECT_TIMEOUT=15

# ---- gateway surface ----
REQUIRE_GATEWAY_AUTH=true
GATEWAY_RPM=0
MAX_BODY_BYTES=2097152
# Fixed client-facing key (recommended on ephemeral filesystems so the key
# survives restarts). Leave empty to auto-generate and print one at boot.
GATEWAY_KEY=

# ---- web hardening ----
# empty CORS_ORIGINS => same-origin only
CORS_ORIGINS=
TRUSTED_HOSTS=*
ENABLE_DOCS=false
FORCE_HTTPS=false
ADMIN_MAX_FAILS=10
ADMIN_LOCK_SECONDS=300
# block upstreams that resolve to private/loopback ranges
BLOCK_PRIVATE_UPSTREAMS=false

# ---- egress (static / allowlisted outbound IP) ----
# Force all upstream calls through one proxy with a fixed, allowlisted IP.
# If unset, standard HTTP_PROXY/HTTPS_PROXY/NO_PROXY env vars are honoured.
EGRESS_PROXY=
# Cap upstream requests/minute per egress IP. Set BELOW your provider's per-IP
# limit so the gateway throttles (compliantly) instead of tripping a ban. 0=off.
EGRESS_IP_RPM=0
# Optional URL that echoes the caller's IP; used by GET /admin/api/egress?check=1
EGRESS_CHECK_URL=

# ---- scaling (optional) ----
# Redis URL to share rate windows + cooldowns across instances. Empty = in-process.
# Note: configuration (SQLite) and concurrency caps remain per instance.
REDIS_URL=

# ---- misc ----
LOG_REQUESTS=true
MAX_LOG_ROWS=5000

# ---- observability ----
# text | json (json emits one structured object per line)
LOG_FORMAT=text
METRICS_ENABLED=true
# expose /metrics without the admin token (default: admin-auth required)
METRICS_PUBLIC=false
# base64 of an exported config JSON, auto-imported on first boot
BOOTSTRAP_CONFIG=
# OR a URL to a JSON config (restored on boot when the DB is empty) - keeps
# config across restarts on hosts with an ephemeral disk
BOOTSTRAP_URL=
# Auto-save: PUT the full config to this URL after every change (pair with
# BOOTSTRAP_URL = same URL to auto-restore). Honoured header: Bearer PERSIST_TOKEN.
PERSIST_URL=
PERSIST_TOKEN=

# ---- optional: Cloudflare Tunnel (docker compose --profile tunnel) ----
# TUNNEL_TOKEN=
